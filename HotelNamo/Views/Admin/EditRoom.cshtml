@model HotelNamo.Models.Room
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Room";
}

<h2 class="mb-3">Edit Room</h2>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="EditRoom" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="RoomNumber" class="form-label"></label>
                    <input asp-for="RoomNumber" class="form-control" />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option>Available</option>
                        <option>Occupied</option>
                        <option>Maintenance</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <h5>Current Images</h5>
                <div class="row g-2">
                    @if (Model.RoomImages != null && Model.RoomImages.Any())
                    {
                        foreach (var img in Model.RoomImages)
                        {
                            <div class="col-6 col-md-3">
                                <img src="@Url.Content($"~/images/rooms/{img.ImagePath}")" class="img-fluid rounded border"
                                     alt="Room image"
                                     onerror="this.onerror=null; this.src='@Url.Content("~/images/rooms/deluxe-room.jpg")';" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-muted">No images for this room.</div>
                    }
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end gap-2">
                <a asp-action="RoomList" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
