@model IEnumerable<UserWithRolesViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Users";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .role-badge {
            background-color: #f0f1f7;
            color: #4b5563;
            border: 1px solid #e5e7eb;
        }

        .table thead th {
            background: #f8f9fb;
        }

        .search-input {
            max-width: 320px;
        }
    </style>
}

<div class="page-header">
    <div>
        <h2 class="mb-0">Manage Users</h2>
        <small class="text-muted">View roles and perform quick actions</small>
    </div>
    <div class="d-flex gap-2">
        <input type="text" id="userSearch" class="form-control form-control-sm search-input"
               placeholder="Search by email..." />
        <a asp-action="CreateStaff" class="btn btn-sm btn-primary">Create Staff User</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0" id="usersTable">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Roles != null && item.Roles.Any())
                                {
                                    foreach (var role in item.Roles)
                                    {
                                        <span class="badge role-badge me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditUser" asp-route-id="@item.UserId"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="DeleteUser" asp-route-id="@item.UserId"
                                   class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('userSearch').addEventListener('input', function () {
            const term = this.value.toLowerCase();
            document.querySelectorAll('#usersTable tbody tr').forEach(row => {
                const email = row.children[0].innerText.toLowerCase();
                row.style.display = email.includes(term) ? '' : 'none';
            });
        });
    </script>
}
