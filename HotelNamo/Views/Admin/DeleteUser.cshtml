@model HotelNamo.Models.UserWithRolesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete User";
}

<h2 class="mb-3">Delete User</h2>
<div class="alert alert-warning">
    Are you sure you want to delete <strong>@Model.Email</strong>? This action cannot be
    undone.
</div>
<form asp-action="DeleteUser" method="post">
    <input type="hidden" asp-for="UserId" />
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="ListUsers" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
