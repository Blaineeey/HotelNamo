@model HotelNamo.Models.Room
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Room {Model.RoomNumber}";
}

<h2 class="mb-3">Room @Model.RoomNumber</h2>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">Images</h5>
                <div class="row g-2">
                    @if (Model.RoomImages != null && Model.RoomImages.Any())
                    {
                        foreach (var img in Model.RoomImages)
                        {
                            <div class="col-6">
                                <img src="@Url.Content($"~/images/rooms/{img.ImagePath}")" class="img-fluid rounded"
                                     alt="Room image"
                                     onerror="this.onerror=null; this.src='@Url.Content("~/images/rooms/deluxe-room.jpg")';" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-muted">No images uploaded for this room.</div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">Details</h5>
                <div class="mb-2"><strong>Category:</strong> @Model.Category</div>
                <div class="mb-2"><strong>Status:</strong> <span class="badge bg-dark">@Model.Status</span></div>
                <div class="mb-2"><strong>Price:</strong> @Model.Price.ToString("C0")</div>
                <div class="mb-2"><strong>Description:</strong> @Model.Description</div>
                <div class="mb-2">
                    <strong>Amenities:</strong>
                    <div class="mt-1">
                        @if (Model.RoomAmenities != null && Model.RoomAmenities.Any())
                        {
                            foreach (var a in Model.RoomAmenities)
                            {
                                <span class="badge bg-light text-dark me-1">@a.Amenity?.Name</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No amenities listed.</span>
                        }
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-action="EditRoom" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="RoomList" class="btn btn-outline-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
