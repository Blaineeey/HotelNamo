@model IEnumerable<HotelNamo.Models.Booking>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Bookings";
}

<h2>All Bookings</h2>
<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Room</th>
            <th>User</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            var userName = b.User != null ? ($"{b.User.FirstName} {b.User.LastName}".Trim()) : b.UserId;
            <tr>
                <td>@b.Id</td>
                <td>@(b.Room?.RoomNumber ?? "N/A")</td>
                <td>@(string.IsNullOrWhiteSpace(userName) ? "N/A" : userName)</td>
                <td>@b.CheckInDate.ToShortDateString()</td>
                <td>@b.CheckOutDate.ToShortDateString()</td>
                <td>
                    @if (!b.IsConfirmed)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (b.IsConfirmed && b.ActualCheckInTime == null)
                    {
                        <span class="badge bg-info">Confirmed</span>
                    }
                    else if (b.ActualCheckInTime != null && b.ActualCheckOutTime == null)
                    {
                        <span class="badge bg-primary">Checked In</span>
                    }
                    else if (b.ActualCheckOutTime != null)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                </td>
                <td>
                    @if (!b.IsConfirmed)
                    {
                        <a asp-action="ConfirmBooking" asp-route-bookingId="@b.Id"
                           class="btn btn-sm btn-success me-1">Confirm</a>
                    }
                    @if (b.IsConfirmed && b.ActualCheckInTime == null)
                    {
                        <a asp-action="AdminCheckIn" asp-route-bookingId="@b.Id" class="btn btn-sm btn-primary me-1">
                            Check
                            In
                        </a>
                    }
                    @if (b.ActualCheckInTime != null && b.ActualCheckOutTime == null)
                    {
                        <a asp-action="AdminCheckOut" asp-route-bookingId="@b.Id" class="btn btn-sm btn-danger">Check Out</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
