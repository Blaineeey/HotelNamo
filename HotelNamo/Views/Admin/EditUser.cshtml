@model HotelNamo.Models.UserWithRolesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit User";
}

<h2 class="mb-3">Edit User</h2>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="UserId" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select name="selectedRole" class="form-select">
                    <option value="">-- Select Role --</option>
                    @{
                        var roleList = (IEnumerable<string>)ViewBag.Roles;
                        var currentRole = Model.Roles != null && Model.Roles.Any() ? Model.Roles.First() : null;
                        foreach (var role in roleList)
                        {
                            <option value="@role" selected="@(currentRole == role ? "selected" : null)">@role</option>
                        }
                    }
                </select>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="ListUsers" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
