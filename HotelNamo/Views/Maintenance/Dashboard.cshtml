@model List<HotelNamo.Models.MaintenanceRequest>
@{
    Layout = "_MaintenanceLayout";
    ViewData["Title"] = "Maintenance Dashboard";
}

<h2 class="mb-3">My Maintenance Requests</h2>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Issue</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Room?.RoomNumber (@m.Room?.Category)</td>
                            <td>@m.IssueDescription</td>
                            <td><span class="badge bg-secondary">@m.Status</span></td>
                            <td class="text-end">
                                @if (m.Status == "Pending")
                                {
                                    <form asp-action="Start" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Doing</button>
                                    </form>
                                }
                                @if (m.Status == "Pending" || m.Status == "Doing")
                                {
                                    <form asp-action="Complete" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Done</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-muted">No assigned requests.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
